# ==============================================================================
# Cedar Lane Auto Detailing — Environment Configuration
# ==============================================================================

# LLM Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Workspace Integration
# Set USE_MOCK_INTEGRATIONS=true to develop and test without Google Cloud credentials
USE_MOCK_INTEGRATIONS=true
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Phase 2: Vapi Voice Integration (Optional for Phase 1)
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
