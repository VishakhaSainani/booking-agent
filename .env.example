# ==============================================================================
# Cedar Lane Auto Detailing — Environment Configuration
# ==============================================================================

# LLM Provider Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Workspace Integration
# Set USE_MOCK_INTEGRATIONS=true to develop and test without Google Cloud credentials
USE_MOCK_INTEGRATIONS=true
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Server Configuration
PORT=8008
HOST=0.0.0.0
DEBUG=true

# Phase 2: Vapi Voice Integration (Sub-1.2s Voice Agent)
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
VAPI_PUBLIC_KEY=your_vapi_public_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
WEBHOOK_URL=https://your-ngrok-domain.ngrok-free.app/api/vapi/webhook
